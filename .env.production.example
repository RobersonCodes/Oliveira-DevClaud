# Copy to .env.production at the repository root and fill in every placeholder before deploying.
# Compose does not use service-level `env_file` entries for ${...} interpolation, so always pass
# this file explicitly from the repository root:
#   docker compose --env-file .env.production -f infra/production/docker-compose.prod.yml up -d
# Never commit the filled-in file.

NODE_ENV=production

# --- Postgres (read by the postgres service itself, and folded into DATABASE_URL below) ---
POSTGRES_USER=oliveira
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=devcloud
DATABASE_URL=postgresql://oliveira:replace-with-a-strong-password@postgres:5432/devcloud?schema=public

REDIS_URL=redis://redis:6379

# Public hostname of the *panel* (web + API under /api) — used by nginx (server_name) and should
# match the certificate in infra/production/certs/panel/. No scheme, no trailing slash. This is
# deliberately NOT the same registrable domain/site as RUNTIME_BASE_DOMAIN below. A merely
# different subdomain would isolate DOM origins but would still let hostile runtime JavaScript
# plant parent-domain cookies into the control plane.
DEV_CLOUD_HOST=app.oliveiradevcloud.com

# Same-origin in production: nginx proxies /api/ to the api service on this same host, so the
# browser should call the API through the site's own origin, not a separate hostname/port.
WEB_ORIGIN=https://app.oliveiradevcloud.com
NEXT_PUBLIC_API_URL=https://app.oliveiradevcloud.com

# Base domain for the Runtime Gateway. Deliberately a separately registered site from
# DEV_CLOUD_HOST above (oliveiradevcloud-content.com vs oliveiradevcloud.com — not just a
# subdomain of the same registrable domain). Production needs wildcard DNS
# (*.runtime.oliveiradevcloud-content.com -> this host), a matching wildcard TLS certificate at
# infra/production/certs/runtime/ and the nginx server block in infra/production/nginx.prod.conf —
# step by step in docs/RUNTIME-GATEWAY-DEPLOY.md.
RUNTIME_BASE_DOMAIN=runtime.oliveiradevcloud-content.com
# Generate: openssl rand -base64 32
RUNTIME_TICKET_SECRET=replace-with-a-random-32-byte-value

API_PORT=4000
SESSION_TTL_DAYS=14
# Comma-separated platform operators allowed to read host-wide metrics.
HOST_ADMIN_EMAILS=admin@example.com

# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY_BASE64=replace-with-exactly-32-byte-base64-key

WORKER_CONCURRENCY=2
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=oliveira-devcloud/workspace-node:1.0
WORKSPACE_ROOT=/var/lib/oliveira-devcloud/workspaces
# Each workspace now gets its own dedicated Docker bridge network, created/removed automatically
# (packages/workspace-engine/src/network.ts) instead of every workspace sharing one network — this
# is what stops workspace A reaching workspace B by IP (P0-3). There is no WORKSPACE_NETWORK to
# configure anymore.
#
# RELAY_CONTAINER_NAME is NOT read from this file — docker-compose.prod.yml sets it directly on the
# `api` service, matching that service's `container_name: odc-api`, since it must always equal the
# api container's own identity and never depends on operator config.

# Host-side path that infra/production/docker-compose.prod.yml bind-mounts into api/worker at the
# same path as WORKSPACE_ROOT above. This is a docker-compose variable, not read by Node directly —
# it must be a REAL directory on the machine running `docker compose`, writable by uid 10001 (the
# workspace image's non-root user), created before first run:
#   sudo mkdir -p /var/lib/oliveira-devcloud/workspaces && sudo chown 10001:10001 /var/lib/oliveira-devcloud/workspaces
# Using a named Docker volume here instead would break workspace creation: workspace-engine hands
# this path to the HOST Docker daemon (via the socket) to bind-mount into sibling workspace
# containers, and the host daemon can only resolve real host paths, not paths that only exist inside
# the api/worker container's own filesystem.
WORKSPACE_ROOT_HOST=/var/lib/oliveira-devcloud/workspaces

# v1.6 AI planner
DEFAULT_AI_PLANNER_PROVIDER=OPENAI
OPENAI_PLANNER_MODEL=gpt-5-mini
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-5
AI_PLANNER_TIMEOUT_MS=30000
