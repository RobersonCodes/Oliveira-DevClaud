# Copy to .env.production at the repository root and fill in every placeholder before deploying.
# Compose does not use service-level `env_file` entries for ${...} interpolation, so always pass
# this file explicitly from the repository root:
#   docker compose --env-file .env.production -f infra/production/docker-compose.prod.yml up -d
# Never commit the filled-in file.

NODE_ENV=production
SECURE_CONFIG_REQUIRED=true

# --- Postgres (read by the postgres service itself, and folded into DATABASE_URL below) ---
POSTGRES_USER=oliveira
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=devcloud
DATABASE_URL=postgresql://oliveira:replace-with-a-strong-password@postgres:5432/devcloud?schema=public

REDIS_URL=redis://redis:6379

# Public hostname of the *panel* (web + API under /api) — used by the edge nginx (server_name) and
# must match the certificate it terminates for this host. No scheme, no trailing slash. Deliberately
# NOT the same registrable domain/site as RUNTIME_BASE_DOMAIN below. A merely different subdomain
# would isolate DOM origins but would still let hostile runtime JavaScript plant parent-domain
# cookies into the control plane.
DEV_CLOUD_HOST=app.aifunnelpro.com.br

# Same-origin in production: the edge nginx proxies /api/ to the api service on this same host, so
# the browser calls the API through the site's own origin, not a separate hostname/port. Since
# Fase 1, the web app itself has no API URL to configure — apps/web/lib/apiClient.ts only ever
# issues relative (`/api/v1/...`) requests, so there is no NEXT_PUBLIC_API_URL to set here anymore.
WEB_ORIGIN=https://app.aifunnelpro.com.br
# Exact address/CIDR of the Docker network gateway through which the host nginx reaches this
# container. Discover it as documented in docs/PRODUCTION-OPERATIONS.md; never use 0.0.0.0/0 or a
# broad private range, because only these peers may supply X-Forwarded-* identity headers.
TRUSTED_PROXY_CIDRS=replace-with-compose-network-gateway/32

# Base domain for the Runtime Gateway. Deliberately a separately registered site from
# DEV_CLOUD_HOST above (tiremax.shop vs aifunnelpro.com.br — not just a subdomain of the same
# registrable domain). Production needs wildcard DNS (*.runtime.tiremax.shop -> this host), a
# matching wildcard TLS certificate, and the nginx server block described in
# docs/RUNTIME-GATEWAY-DEPLOY.md — step by step there.
RUNTIME_BASE_DOMAIN=runtime.tiremax.shop
# Generate: openssl rand -base64 32
RUNTIME_TICKET_SECRET=replace-with-a-random-32-byte-value

API_PORT=4000
SESSION_TTL_DAYS=14

# --- Convivência com um nginx de borda já existente no host (VPS compartilhada) ---
# Por padrão este compose NÃO publica 80/443 nem inicia seu serviço nginx opcional: quando o host já
# serve outro site (nginx do sistema ocupando 80/443), o edge TLS/roteamento fica por conta desse
# nginx externo — ver infra/production/nginx-devcloud.host.conf.example e
# docs/RUNTIME-GATEWAY-DEPLOY.md. O profile `standalone-nginx` preserva o caminho de VPS exclusiva.
# web/api só publicam para 127.0.0.1 nestas portas; confirme com `sudo ss -lntp` que estão livres no
# host antes do primeiro `docker compose up` e ajuste se colidirem com algo que já esteja rodando.
DEVCLOUD_WEB_HOST_PORT=18080
DEVCLOUD_API_HOST_PORT=18081
# Comma-separated platform operators allowed to read host-wide metrics.
HOST_ADMIN_EMAILS=admin@example.com

# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY_BASE64=replace-with-exactly-32-byte-base64-key

WORKER_CONCURRENCY=2

# Runtime Broker (Fase 4 / P1-5) — the only service that holds docker.sock. api/worker never touch
# it directly anymore; they call the broker over the internal compose network instead.
RUNTIME_BROKER_URL=http://runtime-broker:5001
# Generate: openssl rand -base64 32. Shared secret between api/worker (as callers) and the broker
# (which validates it) — a caller holding this token still cannot construct arbitrary Docker
# operations, since the broker's own contract is narrow and allowlisted; this only proves the
# caller is api/worker and not something else on the compose network.
RUNTIME_BROKER_TOKEN=replace-with-a-random-32-byte-value

# Read only by the broker (DOCKER_SOCKET/WORKSPACE_IMAGE) — api/worker no longer read these at all.
DOCKER_SOCKET=/var/run/docker.sock
# Numeric group owner of the host socket. On the production host:
#   stat -c '%g' /var/run/docker.sock
# Compose adds this GID only to the non-root runtime-broker process; do not run the broker as root.
DOCKER_GID=998
# Published from workspace-node-v1.1.0. Keep production pinned to this immutable OCI index digest;
# the clean-install runbook documents the pull and the local-build fallback.
WORKSPACE_IMAGE=ghcr.io/robersoncodes/oliveira-devcloud-workspace-node@sha256:90bacb592d8278bd7ee91f023220428663fa7087497807806e871004b2377a4a
# Read by broker (bind path), api (mkdir/chown) and worker (quota scan). It must be identical in all
# three services and match WORKSPACE_ROOT_HOST below.
WORKSPACE_ROOT=/var/lib/oliveira-devcloud/workspaces
# Each workspace gets its own dedicated Docker bridge network, created/removed automatically
# (apps/runtime-broker/src/network.ts) instead of every workspace sharing one network — this is what
# stops workspace A reaching workspace B by IP (P0-3). There is no WORKSPACE_NETWORK to configure.
#
# RELAY_CONTAINER_NAME is NOT read from this file — docker-compose.prod.yml sets it directly on the
# `runtime-broker` service, matching the `api` service's `container_name: odc-api`, since it must
# always equal the api container's own identity and never depends on operator config.

# Host-side path that infra/production/docker-compose.prod.yml bind-mounts read-write into api and
# read-only into worker (not into broker — see the comments on each service) at the same path as
# WORKSPACE_ROOT above. This is a docker-compose variable, not read by Node directly — it must be a
# REAL directory on the machine running `docker compose`, writable by uid 10001 (the workspace
# image's non-root user) and readable by the worker, created before first run:
#   sudo mkdir -p /var/lib/oliveira-devcloud/workspaces && sudo chown 10001:10001 /var/lib/oliveira-devcloud/workspaces
# Using a named Docker volume here instead would break workspace creation: the broker hands this
# path to the HOST Docker daemon (via the socket) to bind-mount into sibling workspace containers,
# and the host daemon only ever resolves real host paths — never a path that only exists inside some
# container's own filesystem.
WORKSPACE_ROOT_HOST=/var/lib/oliveira-devcloud/workspaces

# v1.6 AI planner
DEFAULT_AI_PLANNER_PROVIDER=OPENAI
OPENAI_PLANNER_MODEL=gpt-5-mini
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-5
AI_PLANNER_TIMEOUT_MS=30000
