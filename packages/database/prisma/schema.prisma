generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  DEVELOPER
}
enum WorkspaceStatus {
  CREATING
  RUNNING
  STOPPED
  ERROR
  DESTROYING
}
enum AgentType {
  CODEX
  CLAUDE
}
enum AgentTaskStatus {
  QUEUED
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}
enum AgentReviewStatus {
  PENDING
  READY
  MERGED
  REJECTED
}
enum OrchestrationStatus {
  DRAFT
  QUEUED
  RUNNING
  WAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}
enum OrchestrationStepType {
  AGENT
  SYSTEM
}
enum OrchestrationStepStatus {
  BLOCKED
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SKIPPED
}
enum OrchestrationReviewStatus {
  NOT_READY
  ANALYZING
  CONFLICT
  GATE_FAILED
  READY
  APPROVED
  REJECTED
  MERGED
}
enum SecretScope {
  ORGANIZATION
  PROJECT
  WORKSPACE
}
enum SecretKind {
  GENERIC
  GITHUB_TOKEN
  OPENAI_API_KEY
  ANTHROPIC_API_KEY
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  memberships  OrganizationMember[]
  sessions     Session[]
  auditLogs    AuditLog[]
  commandRuns CommandRun[]
  activityLogs ActivityLog[]
  notifications Notification[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user      User     @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  members   OrganizationMember[]
  projects  Project[]
  auditLogs AuditLog[]
  secrets   Secret[]
  activityLogs ActivityLog[]
}

model OrganizationMember {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  role           Role   @default(DEVELOPER)
  organization   Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  user           User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@unique([organizationId,userId])
  @@index([userId])
}

model Project {
  id             String @id @default(cuid())
  organizationId String
  name           String
  slug           String
  // Kept for backward compatibility — every existing reader (workspace creation, repository
  // bootstrap, etc.) still uses these. New code should prefer `repositories` (see Repository
  // below), which supports more than one repository per project and non-GitHub providers.
  repositoryUrl  String?
  defaultBranch  String @default("main")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  organization   Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  workspaces     Workspace[]
  secrets        Secret[]
  repositories   Repository[]
  @@unique([organizationId, slug])
  @@index([organizationId])
}

enum RepositoryProvider {
  GITHUB
  GITLAB
}

// Promotes the single repositoryUrl/defaultBranch pair on Project into its own model so a project
// can eventually reference more than one repository and providers beyond GitHub (e.g. GitLab).
// Project.repositoryUrl/defaultBranch are left in place and are not read from here (yet) — see the
// migration for the one-time backfill that keeps both in sync for existing projects.
model Repository {
  id            String   @id @default(cuid())
  projectId     String
  provider      RepositoryProvider @default(GITHUB)
  url           String
  defaultBranch String   @default("main")
  lastSyncedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  @@index([projectId])
}

model Workspace {
  id           String @id @default(cuid())
  projectId    String
  containerId  String?
  status       WorkspaceStatus @default(CREATING)
  cpuLimit     Float @default(1)
  memoryMb     Int @default(2048)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActiveAt DateTime @default(now())
  project      Project @relation(fields:[projectId], references:[id], onDelete:Cascade)
  terminals    TerminalSession[]
  ports        WorkspacePort[]
  ideSession   IdeSession?
  agentTasks   AgentTask[]
  agentRuns    AgentRun[]
  orchestrations Orchestration[]
  secrets        Secret[]
  setupJobs      SetupJob[]
  commandRuns    CommandRun[]
  repositorySnapshots RepositorySnapshot[]
  codeIntelligenceSnapshots CodeIntelligenceSnapshot[]
  contractIntelligenceSnapshots ContractIntelligenceSnapshot[]
  activityLogs ActivityLog[]
  @@index([projectId])
}

model TerminalSession {
  id           String   @id @default(cuid())
  workspaceId  String
  tmuxName     String
  title        String   @default("Terminal")
  active       Boolean  @default(true)
  cols         Int      @default(120)
  rows         Int      @default(34)
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  workspace    Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId, tmuxName])
  @@index([workspaceId, active])
}

model WorkspacePort {
  id          String   @id @default(cuid())
  workspaceId String
  port        Int
  label       String?
  protocol    String   @default("http")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId, port])
  @@index([workspaceId])
}

model IdeSession {
  id           String   @id @default(cuid())
  workspaceId  String   @unique
  active       Boolean  @default(false)
  port         Int      @default(13337)
  startedAt    DateTime?
  lastActiveAt DateTime @default(now())
  workspace    Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
}

model AgentTask {
  id          String @id @default(cuid())
  workspaceId String
  agent       AgentType
  title       String
  prompt      String
  status      AgentTaskStatus @default(QUEUED)
  startedAt   DateTime?
  finishedAt  DateTime?
  exitCode    Int?
  metadata    Json?
  branchName  String?
  worktreePath String?
  baseCommit  String?
  reviewStatus AgentReviewStatus @default(PENDING)
  mergeCommit String?
  mergedAt    DateTime?
  rejectedAt  DateTime?
  workspace   Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  runs        AgentRun[]
  orchestrationStep OrchestrationStep?
  @@index([workspaceId, status])
}

model AgentRun {
  id          String   @id @default(cuid())
  taskId      String
  workspaceId String
  sessionName String
  statusFile  String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  exitCode    Int?
  cancelledAt DateTime?
  task        AgentTask @relation(fields:[taskId], references:[id], onDelete:Cascade)
  workspace   Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@index([taskId, startedAt])
  @@index([workspaceId, startedAt])
}


model Orchestration {
  id          String @id @default(cuid())
  workspaceId String
  title       String
  objective   String
  status      OrchestrationStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  reviewStatus OrchestrationReviewStatus @default(NOT_READY)
  reviewBranch String?
  reviewWorktreePath String?
  reviewBaseCommit String?
  reviewSummary Json?
  mergeCommit String?
  reviewedAt DateTime?
  approvedAt DateTime?
  rejectedAt DateTime?
  mergedAt DateTime?
  workspace   Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  steps       OrchestrationStep[]
  commandRuns CommandRun[]
  @@index([workspaceId, status])
}

model OrchestrationStep {
  id              String @id @default(cuid())
  orchestrationId String
  key             String
  title           String
  type            OrchestrationStepType
  status          OrchestrationStepStatus @default(BLOCKED)
  agent           AgentType?
  prompt          String?
  taskContext     Json?
  command         String?
  dependsOn       String[] @default([])
  agentTaskId     String? @unique
  exitCode        Int?
  output          String?
  startedAt       DateTime?
  finishedAt      DateTime?
  orchestration   Orchestration @relation(fields:[orchestrationId], references:[id], onDelete:Cascade)
  agentTask       AgentTask? @relation(fields:[agentTaskId], references:[id], onDelete:SetNull)
  @@unique([orchestrationId, key])
  @@index([orchestrationId, status])
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  resource       String
  resourceId     String?
  ipAddress      String?
  metadata       Json?
  createdAt      DateTime @default(now())
  user           User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  organization   Organization? @relation(fields:[organizationId], references:[id], onDelete:SetNull)
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

// General-purpose activity feed (git.changed, build.completed, test.failed, workspace.created, ...),
// distinct from AuditLog (which stays reserved for sensitive/security-relevant actions). Feeds the
// dashboard activity list and, later, the typed event bus.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  userId         String?
  type           String
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  workspace      Workspace? @relation(fields:[workspaceId], references:[id], onDelete:SetNull)
  user           User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  ACTION_REQUIRED
}

model Notification {
  id                String   @id @default(cuid())
  userId            String
  type              NotificationType @default(INFO)
  title             String
  read              Boolean  @default(false)
  relatedResource   String?
  relatedResourceId String?
  createdAt         DateTime @default(now())
  user              User @relation(fields:[userId], references:[id], onDelete:Cascade)
  @@index([userId, read])
  @@index([userId, createdAt])
}


model Secret {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String?
  workspaceId    String?
  scope          SecretScope @default(ORGANIZATION)
  kind           SecretKind  @default(GENERIC)
  name           String
  encryptedValue Json
  maskedValue    String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  organization   Organization @relation(fields:[organizationId], references:[id], onDelete:Cascade)
  project        Project? @relation(fields:[projectId], references:[id], onDelete:Cascade)
  workspace      Workspace? @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([organizationId, scope, name, projectId, workspaceId])
  @@index([organizationId, kind])
  @@index([projectId])
  @@index([workspaceId])
}

enum SetupJobStatus {
  QUEUED
  RUNNING
  READY
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}
enum SetupStage {
  QUEUED
  CREATING_CONTAINER
  CLONING_REPOSITORY
  DETECTING_STACK
  INSTALLING_DEPS
  CONFIGURING_PORTS
  STARTING_IDE
  READY
  FAILED
  CANCELLED
}

model SetupJob {
  id             String         @id @default(cuid())
  workspaceId    String
  userId         String?
  organizationId String
  status         SetupJobStatus @default(QUEUED)
  stage          SetupStage     @default(QUEUED)
  progress       Int            @default(0)
  message        String?
  options        Json?
  result         Json?
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime       @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  updatedAt      DateTime       @updatedAt
  heartbeatAt    DateTime?
  attempt        Int            @default(1)
  parentJobId    String?
  logs           SetupJobLog[]
  workspace      Workspace      @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@index([workspaceId, createdAt])
  @@index([organizationId, status])
}

model SetupJobLog {
  id        String   @id @default(cuid())
  setupJobId String
  level     String   @default("INFO")
  message   String
  stage     SetupStage?
  createdAt DateTime @default(now())
  setupJob  SetupJob @relation(fields:[setupJobId], references:[id], onDelete:Cascade)
  @@index([setupJobId, createdAt])
}


model RepositorySnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  commitSha   String
  branch      String?
  payload     Json
  generatedAt DateTime @default(now())
  workspace   Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId, commitSha])
  @@index([workspaceId, generatedAt])
}

enum CommandRunStatus {
  PLANNING
  READY
  STARTED
  FAILED
}
enum PlannerProvider {
  DETERMINISTIC
  OPENAI
  ANTHROPIC
}

model CommandRun {
  id                String @id @default(cuid())
  workspaceId       String
  userId            String?
  objective         String
  status            CommandRunStatus @default(PLANNING)
  repositoryContext Json?
  plan              Json?
  plannerProvider   PlannerProvider @default(DETERMINISTIC)
  plannerFallbackReason String?
  orchestrationId   String?
  errorMessage      String?
  createdAt         DateTime @default(now())
  startedAt         DateTime?
  workspace         Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  user              User? @relation(fields:[userId], references:[id], onDelete:SetNull)
  orchestration     Orchestration? @relation(fields:[orchestrationId], references:[id], onDelete:SetNull)
  @@index([workspaceId, createdAt])
}


model CodeIntelligenceSnapshot {
  id String @id @default(cuid())
  workspaceId String
  commitSha String
  payload Json
  generatedAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId, commitSha])
  @@index([workspaceId, generatedAt])
}

model ContractIntelligenceSnapshot {
  id String @id @default(cuid())
  workspaceId String
  commitSha String
  payload Json
  generatedAt DateTime @default(now())
  workspace Workspace @relation(fields:[workspaceId], references:[id], onDelete:Cascade)
  @@unique([workspaceId, commitSha])
  @@index([workspaceId, generatedAt])
}
