FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
# Fase 1 hardening: the client bundle no longer references any API host at all — every request is
# same-origin and relative (see apps/web/lib/apiClient.ts and apps/web/next.config.js), routed by
# nginx in production. There is nothing left to inline as a build ARG here.
RUN npm install && npm run build -w @oliveira/web
CMD ["npm","run","start","-w","@oliveira/web"]
