FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
# Next.js inlines NEXT_PUBLIC_* into the client bundle at `next build` time, not at container start —
# `env_file`/`environment` in docker-compose only affect the running container's process.env, which
# is too late. It must be passed as a build ARG (docker-compose.prod.yml wires this to the
# NEXT_PUBLIC_API_URL variable in .env.production) or every page falls back to its hardcoded
# `http://localhost:4000` default, which only works on the machine running the browser, never in
# production.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
RUN npm install && npm run build -w @oliveira/web
CMD ["npm","run","start","-w","@oliveira/web"]
