NODE_ENV=development
# The production API image forces this to true. It prevents a production container from silently
# booting with NODE_ENV unset/development and therefore issuing non-Secure session cookies.
SECURE_CONFIG_REQUIRED=false
DATABASE_URL=postgresql://oliveira:oliveira@localhost:5433/devcloud?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# Empty means forwarded headers are ignored. Production must list only its real proxy/gateway CIDRs.
TRUSTED_PROXY_CIDRS=
# Fase 1 hardening: the web app has no API URL of its own to configure anymore — every request from
# the browser is same-origin and relative (apps/web/lib/apiClient.ts), proxied to the API by
# apps/web/next.config.js in dev (reads API_PORT below) and by nginx in production. There is no
# NEXT_PUBLIC_API_URL/NEXT_PUBLIC_API_BASE to set.
API_PORT=4000
# Base domain for the origin-isolated Runtime Gateway (IDE/preview), served under
# ide-<workspaceId>.<this> and preview-<workspaceId>-<port>.<this> — never the same origin as the
# panel. Production must use a different registrable domain/site from the control plane to prevent
# related-domain cookie injection. `runtime.localhost` is only a development convenience: modern
# browsers and most OS resolvers already treat any `*.localhost` as 127.0.0.1.
RUNTIME_BASE_DOMAIN=runtime.localhost
# Signs short-lived Runtime Gateway tickets/cookies (HMAC-SHA256) — a different key from
# SECRETS_MASTER_KEY_BASE64 (that one encrypts user secrets at rest; this one only ever signs, never
# encrypts, and rotating it just forces every open IDE/preview tab to re-authenticate).
# Generate: openssl rand -base64 32
RUNTIME_TICKET_SECRET=replace-with-a-random-32-byte-value
SESSION_TTL_DAYS=14
# Comma-separated emails allowed to read host-wide metrics. Organization roles are not global roles.
HOST_ADMIN_EMAILS=admin@example.com
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY_BASE64=replace-with-exactly-32-byte-base64-key
WORKER_CONCURRENCY=2

# Runtime Broker (Fase 4 / P1-5) — api/worker (and every *-engine package) talk to Docker only
# through this service now, never through docker.sock directly. `npm run dev` at the repo root
# starts it alongside web/api/worker (see the root "dev" script); it must be running for anything
# that touches a workspace container (create/start/stop, exec, terminal, agents, git, IDE) to work
# in local dev.
RUNTIME_BROKER_URL=http://localhost:5001
RUNTIME_BROKER_PORT=5001
# Generate: openssl rand -base64 32 — any value works in dev, just needs to match between this file
# (read by api/worker as the client credential) and the broker process itself (same file, same var).
RUNTIME_BROKER_TOKEN=dev-only-local-token

# Read only by the broker.
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=oliveira-devcloud/workspace-node:1.1.0
WORKSPACE_ROOT=/var/lib/oliveira-devcloud/workspaces
# Reaper: runs in the API, confirms PostgreSQL + broker labels before deleting old orphan storage.
ORPHAN_REAPER_INTERVAL_MS=300000
ORPHAN_REAPER_GRACE_MS=3600000
# Each workspace gets its own dedicated Docker bridge network, created/removed automatically
# (apps/runtime-broker/src/network.ts) — there is no shared WORKSPACE_NETWORK to configure anymore.
# RELAY_CONTAINER_NAME only matters when the broker itself runs inside a container (see
# .env.production.example); leave it unset here, since in dev the broker runs directly on the host.
# v1.6 AI planner
DEFAULT_AI_PLANNER_PROVIDER=OPENAI
OPENAI_PLANNER_MODEL=gpt-5-mini
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-5
AI_PLANNER_TIMEOUT_MS=30000
