NODE_ENV=development
DATABASE_URL=postgresql://oliveira:oliveira@localhost:5432/devcloud?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
SESSION_TTL_DAYS=14
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY_BASE64=replace-with-exactly-32-byte-base64-key
WORKER_CONCURRENCY=2
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=oliveira-devcloud/workspace-node:1.0
WORKSPACE_ROOT=/var/lib/oliveira-devcloud/workspaces
WORKSPACE_NETWORK=bridge
# v1.6 AI planner
DEFAULT_AI_PLANNER_PROVIDER=OPENAI
OPENAI_PLANNER_MODEL=gpt-5-mini
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-5
AI_PLANNER_TIMEOUT_MS=30000
