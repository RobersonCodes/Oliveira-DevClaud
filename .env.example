NODE_ENV=development
DATABASE_URL=postgresql://oliveira:oliveira@localhost:5433/devcloud?schema=public
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000
# Base domain for the origin-isolated Runtime Gateway (IDE/preview), served under
# ide-<workspaceId>.<this> and preview-<workspaceId>-<port>.<this> — never the same origin as the
# panel. `runtime.localhost` needs no DNS/hosts-file setup: modern browsers and most OS resolvers
# already treat any `*.localhost` as 127.0.0.1.
RUNTIME_BASE_DOMAIN=runtime.localhost
# Signs short-lived Runtime Gateway tickets/cookies (HMAC-SHA256) — a different key from
# SECRETS_MASTER_KEY_BASE64 (that one encrypts user secrets at rest; this one only ever signs, never
# encrypts, and rotating it just forces every open IDE/preview tab to re-authenticate).
# Generate: openssl rand -base64 32
RUNTIME_TICKET_SECRET=replace-with-a-random-32-byte-value
SESSION_TTL_DAYS=14
# Comma-separated emails allowed to read host-wide metrics. Organization roles are not global roles.
HOST_ADMIN_EMAILS=admin@example.com
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY_BASE64=replace-with-exactly-32-byte-base64-key
WORKER_CONCURRENCY=2
DOCKER_SOCKET=/var/run/docker.sock
WORKSPACE_IMAGE=oliveira-devcloud/workspace-node:1.0
WORKSPACE_ROOT=/var/lib/oliveira-devcloud/workspaces
WORKSPACE_NETWORK=bridge
# v1.6 AI planner
DEFAULT_AI_PLANNER_PROVIDER=OPENAI
OPENAI_PLANNER_MODEL=gpt-5-mini
ANTHROPIC_PLANNER_MODEL=claude-sonnet-4-5
AI_PLANNER_TIMEOUT_MS=30000
